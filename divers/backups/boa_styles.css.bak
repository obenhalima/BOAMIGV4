/* ================================================================
   BOA Afrique — IGOR V2→V4 — Styles
   Externalisé depuis BOA_Programme_Pilotage_Online.html (étape 5)
   ================================================================ */

/* ── Bloc 1 ── */
:root {
  --red: #E63329; --red-dark: #B02820; --red-light: #FDEEEC;
  --orange: #E8702A; --orange-light: #FEF3E2;
  --green: #2E7D52; --green-light: #E8F5ED;
  --gray: #54565A; --gray-light: #F5F5F5; --gray-med: #D0D3D4;
  --black: #000; --white: #fff;
  --font: Arial, sans-serif;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: var(--font); background: #f0f2f5; color: var(--black); font-size: 13px; }

/* HEADER */
.app-header {
  background: var(--white); border-bottom: 4px solid var(--red);
  padding: 10px 20px; display: flex; align-items: center; justify-content: space-between;
  position: sticky; top: 0; z-index: 100; box-shadow: 0 2px 8px rgba(0,0,0,.1);
}
.header-logo { display: flex; align-items: center; gap: 14px; }
.logo-cbs { width: 120px; height: 38px; background: var(--red); border-radius: 3px;
  display: flex; align-items: center; justify-content: center; color: white;
  font-weight: bold; font-size: 11px; letter-spacing: 1px; }
.header-title h1 { font-size: 17px; font-weight: 700; color: var(--black); }
.header-title p { font-size: 11px; color: var(--gray); margin-top: 2px; }
.header-meta { display: flex; gap: 12px; align-items: center; }
.countdown-badge {
  background: var(--red); color: white; padding: 5px 12px; border-radius: 4px;
  font-weight: bold; font-size: 12px; text-align: center;
}
.countdown-badge span { display: block; font-size: 10px; font-weight: normal; }
.today-badge { background: var(--gray-light); color: var(--gray); padding: 5px 12px;
  border-radius: 4px; font-size: 11px; border: 1px solid var(--gray-med); }

/* TABS */
.tabs-nav { background: var(--white); border-bottom: 1px solid var(--gray-med);
  padding: 0 20px; display: flex; gap: 0; }
.tab-btn {
  padding: 11px 20px; border: none; background: none; cursor: pointer;
  font-family: var(--font); font-size: 13px; font-weight: 600; color: var(--gray);
  border-bottom: 3px solid transparent; transition: all .2s; margin-bottom: -1px;
}
.tab-btn:hover { color: var(--red); background: var(--red-light); }
.tab-btn.active { color: var(--red); border-bottom-color: var(--red); background: white; }
.tab-btn .tab-icon { margin-right: 6px; }

/* CONTENT */
.tab-content { display: none; padding: 20px; max-width: 1400px; margin: 0 auto; }
.tab-content.active { display: block; }

/* CARDS */
.kpi-row { display: flex; gap: 12px; margin-bottom: 18px; flex-wrap: wrap; }
.kpi-card {
  flex: 1; min-width: 140px; padding: 14px 16px; border-radius: 6px; color: white;
  box-shadow: 0 2px 6px rgba(0,0,0,.12);
}
.kpi-card .kpi-val { font-size: 36px; font-weight: 900; line-height: 1; }
.kpi-card .kpi-label { font-size: 11px; margin-top: 4px; opacity: .9; }
.kpi-card .kpi-sub { font-size: 10px; margin-top: 2px; opacity: .75; }
.kpi-red { background: var(--red); }
.kpi-dark { background: var(--red-dark); }
.kpi-orange { background: var(--orange); }
.kpi-gray { background: var(--gray); }
.kpi-green { background: var(--green); }

/* SECTIONS */
.section-card { background: white; border-radius: 6px; box-shadow: 0 1px 4px rgba(0,0,0,.08);
  margin-bottom: 16px; overflow: hidden; }
.section-header {
  background: var(--red); color: white; padding: 9px 16px;
  font-weight: 700; font-size: 12px; letter-spacing: .5px; display: flex;
  justify-content: space-between; align-items: center;
}
.section-body { padding: 14px 16px; }

/* TABLES */
.data-table { width: 100%; border-collapse: collapse; font-size: 12px; }
.data-table th {
  background: var(--red); color: white; padding: 8px 10px;
  text-align: left; font-weight: 700; font-size: 11px; white-space: nowrap;
}
.data-table th.center, .data-table td.center { text-align: center; }
.data-table td { padding: 7px 10px; border-bottom: 1px solid #eee; vertical-align: middle; }
.data-table tr:last-child td { border-bottom: none; }
.data-table tr:nth-child(even) td { background: #fafafa; }
.data-table tr:hover td { background: var(--red-light); }

/* BADGES */
.badge { display: inline-block; padding: 2px 8px; border-radius: 3px;
  font-size: 10px; font-weight: 700; white-space: nowrap; }
.badge-p1 { background: var(--red); color: white; }
.badge-p2 { background: var(--orange); color: white; }
.badge-p21 { background: #F5A623; color: white; }
.badge-p3 { background: var(--gray); color: white; }
.badge-crit { background: var(--red-light); color: var(--red); border: 1px solid var(--red); }
.badge-haute { background: var(--orange-light); color: var(--orange); border: 1px solid var(--orange); }
.badge-std { background: var(--green-light); color: var(--green); border: 1px solid var(--green); }
.badge-spec { background: #EEF0F8; color: #3949AB; border: 1px solid #3949AB; }
.badge-ok { background: var(--green-light); color: var(--green); }
.badge-warn { background: var(--orange-light); color: var(--orange); }
.badge-late { background: var(--red-light); color: var(--red); }

/* STATUS SELECT */
.status-select {
  padding: 3px 6px; border-radius: 4px; border: 1px solid var(--gray-med);
  font-family: var(--font); font-size: 11px; cursor: pointer; width: 100%;
}
.status-select.dec-maintien { background: #EEF0F8; color: #3949AB; border-color: #3949AB; }
.status-select.dec-integration { background: var(--green-light); color: var(--green); border-color: var(--green); }
.status-select.dec-abandon { background: var(--red-light); color: var(--red); border-color: var(--red); }
.status-select.dec-encours { background: var(--orange-light); color: var(--orange); border-color: var(--orange); }

/* RAG buttons */
.rag-group { display: flex; gap: 3px; }
.rag-btn {
  padding: 2px 8px; border: none; border-radius: 3px; cursor: pointer;
  font-size: 10px; font-weight: 700; opacity: .35; transition: opacity .15s;
}
.rag-btn:hover { opacity: .7; }
.rag-btn.active { opacity: 1; }
.rag-r { background: var(--red); color: white; }
.rag-o { background: var(--orange); color: white; }
.rag-g { background: var(--green); color: white; }

/* PROGRESS BAR */
.prog-wrap { display: flex; align-items: center; gap: 6px; }
.prog-bar { flex: 1; height: 8px; background: #eee; border-radius: 4px; overflow: hidden; }
.prog-fill { height: 100%; border-radius: 4px; transition: width .3s; }
.prog-fill.pg { background: var(--green); }
.prog-fill.po { background: var(--orange); }
.prog-fill.pr { background: var(--red); }
.prog-pct { font-size: 10px; color: var(--gray); width: 28px; text-align: right; }

/* PROGRESS INPUT */
.prog-input { width: 50px; text-align: center; border: 1px solid var(--gray-med);
  border-radius: 3px; padding: 2px 4px; font-size: 11px; }

/* ALERT ITEM */
.alert-item {
  display: flex; align-items: center; gap: 10px; padding: 8px 12px;
  border-radius: 4px; margin-bottom: 6px; border-left: 4px solid;
}
.alert-red { background: var(--red-light); border-color: var(--red); }
.alert-orange { background: var(--orange-light); border-color: var(--orange); }
.alert-green { background: var(--green-light); border-color: var(--green); }
.alert-icon { font-size: 16px; }
.alert-text .alert-title { font-weight: 700; font-size: 12px; }
.alert-text .alert-sub { font-size: 11px; color: var(--gray); margin-top: 2px; }

/* FILTER BAR */
.filter-bar { display: flex; gap: 8px; margin-bottom: 12px; flex-wrap: wrap; align-items: center; }
.filter-bar select, .filter-bar input {
  padding: 5px 10px; border: 1px solid var(--gray-med); border-radius: 4px;
  font-family: var(--font); font-size: 12px; background: white;
}
.filter-bar label { font-size: 11px; color: var(--gray); }
.btn-reset { padding: 5px 12px; background: var(--gray-light); border: 1px solid var(--gray-med);
  border-radius: 4px; cursor: pointer; font-size: 11px; font-family: var(--font); }
.btn-export { padding: 5px 12px; background: var(--red); color: white; border: none;
  border-radius: 4px; cursor: pointer; font-size: 11px; font-family: var(--font); font-weight: 700; }

/* CBS EXPORT DROPDOWN */
.cbs-export-wrap { position: relative; display: inline-block; }
.cbs-export-btn {
  padding: 5px 11px; background: #1F3864; color: white; border: none;
  border-radius: 4px; cursor: pointer; font-size: 11px; font-family: var(--font);
  font-weight: 700; display: flex; align-items: center; gap: 5px; white-space: nowrap;
}
.cbs-export-btn:hover { background: #152a4e; }
.cbs-export-menu {
  position: absolute; right: 0; top: calc(100% + 4px); z-index: 500;
  background: white; border: 1px solid #ddd; border-radius: 6px;
  box-shadow: 0 4px 16px rgba(0,0,0,.18); min-width: 148px; overflow: hidden;
}
.cbs-export-menu button {
  display: flex; align-items: center; gap: 8px;
  width: 100%; padding: 9px 14px; border: none; background: white;
  cursor: pointer; font-size: 12px; font-family: var(--font); text-align: left;
  color: #222; transition: background .12s;
}
.cbs-export-menu button:hover { background: #f0f2f5; }
.cbs-export-menu .cbs-menu-sep { height: 1px; background: #eee; margin: 2px 0; }

/* DOMAIN PROGRESS */
.domain-row { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
.domain-name { width: 180px; font-size: 11px; font-weight: 600; color: var(--black); }
.domain-bar { flex: 1; height: 18px; background: #eee; border-radius: 3px; overflow: hidden; position: relative; }
.domain-bar-fill { height: 100%; background: var(--red); border-radius: 3px; }
.domain-bar-text { position: absolute; left: 6px; top: 50%; transform: translateY(-50%);
  font-size: 10px; color: white; font-weight: 700; }
.domain-stats { width: 80px; text-align: right; font-size: 11px; color: var(--gray); }

/* ═══════════════════════════════════════════════
   GANTT CHART
════════════════════════════════════════════════ */
.gantt-container { overflow-x: auto; }
.gantt-table { border-collapse: collapse; width: 100%; min-width: 1050px; }
.gantt-table .col-name { width: 185px; min-width: 185px; }
.gantt-table .col-start, .gantt-table .col-end { width: 100px; min-width: 100px; }
.gantt-table .col-bar { width: 100%; min-width: 300px; }

.gantt-table th {
  background: var(--red); color: white; padding: 7px 6px;
  font-size: 11px; font-weight: 700; text-align: left; white-space: nowrap;
  position: sticky; top: 0; z-index: 10;
}
.gantt-month-header { text-align: center; font-size: 11px; font-weight: 700; color: #222; }
.gantt-table td { padding: 4px 6px; border-bottom: 1px solid #eee; vertical-align: middle; }
.gantt-table tr:hover td { background: #f5f7fb; }

.gantt-phase-row td { background: #e4eaf5; font-weight: 700; font-size: 12px; }
.gantt-phase-row td:nth-child(2) { border-left: 4px solid var(--red); }
.gantt-phase-row:hover td { background: #d8e0f0 !important; }
.gantt-jalon-row td { background: #fff8e1; font-weight: 600; font-size: 11px; }
.gantt-jalon-row:hover td { background: #fff0b0 !important; }
.gantt-sub-row td { font-size: 11px; }
.gantt-subtask-row td { font-size: 11px; background: #f4f5ff; }
.gantt-subtask-row td:nth-child(3) { border-left: 3px solid #7986CB; }
.gantt-subtask-row:hover td { background: #e8eaf6 !important; }
.subtask-add-btn { background:none;border:1px solid #9fa8da;color:#3949AB;cursor:pointer;font-size:11px;padding:0px 4px;border-radius:3px;margin-left:2px;line-height:1.4; }
.subtask-add-btn:hover { background:#e8eaf6; }
.subs-toggle-btn { background:none;border:none;cursor:pointer;font-size:10px;padding:1px 3px;color:#7986CB;vertical-align:middle; }
.subs-toggle-btn:hover { color:#3949AB; }

.gantt-bar-cell { position: relative; height: 28px; }
.gantt-months-bg { position: absolute; top: 0; left: 0; right: 0; bottom: 0;
  display: flex; pointer-events: none; }
.month-col { flex: 1; border-right: 1px solid #b8c4d8; background: #f0f4fb; }
.month-col.alt { background: #e2eaf7; }
.month-col:last-child { border-right: none; }

.gantt-bar {
  position: absolute; top: 4px; height: 20px; border-radius: 3px;
  display: flex; align-items: center; padding: 0 5px; font-size: 9px;
  font-weight: 700; color: white; white-space: nowrap; overflow: hidden;
  cursor: pointer; transition: opacity .15s; z-index: 2;
}
.gantt-bar:hover { opacity: .82; }
.gantt-bar.ph-p0 { background: var(--red); }
.gantt-bar.ph-p1 { background: var(--orange); }
.gantt-bar.ph-p2 { background: #546E7A; }
.gantt-bar.ph-p3 { background: var(--green); }
.gantt-bar.ph-p4 { background: #6A1B9A; }
.gantt-bar.ph-p5 { background: var(--red-dark); }
.gantt-milestone {
  position: absolute; top: 3px; font-size: 19px; color: #1565C0; z-index: 3;
  cursor: default; line-height: 22px; font-weight: 900;
  filter: drop-shadow(0 1px 2px rgba(0,0,0,.25));
}
.today-line {
  position: absolute; top: 0; bottom: 0; width: 2px; background: #FF5722;
  z-index: 5; pointer-events: none;
}
.today-line::after {
  content: 'Auj.'; position: absolute; top: -18px; left: -12px;
  font-size: 9px; color: #FF5722; font-weight: 700; white-space: nowrap;
  background: white; padding: 1px 3px; border-radius: 2px;
}

.date-input { padding: 3px 4px; border: 1px solid var(--gray-med); border-radius: 3px;
  font-family: var(--font); font-size: 11px; width: 100%; }
.date-input:focus { outline: none; border-color: var(--red); }

.type-badge { display: inline-block; padding: 1px 5px; border-radius: 3px;
  font-size: 9px; font-weight: 700; white-space: nowrap; }
.type-phase  { background: var(--red); color: white; }
.type-task   { background: #E8EDF5; color: #3a4a6b; border: 1px solid #c0cce0; }
.type-jalon  { background: #1565C0; color: white; }
.type-custom { background: #EEF0F8; color: #3949AB; border: 1px solid #c5cae9; }

.phase-toggle-btn {
  background: none; border: none; cursor: pointer; font-size: 11px;
  margin-right: 3px; color: var(--gray); padding: 0; line-height: 1;
}
.phase-toggle-btn:hover { color: var(--red); }

/* GANTT LEGEND */
.gantt-legend { display: flex; gap: 14px; margin-bottom: 10px; flex-wrap: wrap; }
.legend-item { display: flex; align-items: center; gap: 5px; font-size: 11px; }
.legend-dot { width: 14px; height: 14px; border-radius: 3px; }

/* GANTT ROW NUMBER */
.gantt-row-num { font-size: 10px; color: #aaa; font-weight: 600; min-width: 22px; text-align: center; }

/* GANTT INSERT ROW BUTTON (+ per line) */
.gantt-add-row-btn {
  background: #e8f5e9; border: 1px solid #a5d6a7; color: #2e7d32;
  border-radius: 50%; width: 17px; height: 17px; font-size: 12px; font-weight: 700;
  cursor: pointer; line-height: 1; padding: 0;
  display: inline-flex; align-items: center; justify-content: center;
  opacity: 0.5; transition: opacity .15s, background .15s;
  vertical-align: middle;
}
.gantt-add-row-btn:hover { opacity: 1; background: #c8e6c9; }

/* GANTT DEPENDENCY SVG */
#gantt-dep-svg { pointer-events: none; }

/* GANTT ZOOM BUTTONS */
.gantt-zoom-btn {
  background: #f0f2f5; border: 1px solid #c0c8d8; color: #54565A;
  padding: 3px 9px; border-radius: 4px; font-size: 11px; font-weight: 600;
  cursor: pointer; transition: all .15s; line-height: 1;
}
.gantt-zoom-btn:hover { background: #dde3f0; color: #1565C0; }
.gantt-zoom-btn.active { background: #1565C0; color: white; border-color: #1565C0; }

/* GANTT N° cell: hover → show + button, hide number */
.gantt-num-cell {
  font-size: 10px; color: #aaa; font-weight: 600; min-width: 26px;
  text-align: center; cursor: default; position: relative;
}
.gantt-num-cell .g-num-label { pointer-events: none; }
.gantt-num-cell .g-add-btn {
  display: none; position: absolute; top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  background: #e8f5e9; border: 1px solid #a5d6a7; color: #2e7d32;
  border-radius: 50%; width: 17px; height: 17px; font-size: 13px; font-weight: 700;
  cursor: pointer; line-height: 1; padding: 0;
  align-items: center; justify-content: center;
}
tr:hover .gantt-num-cell .g-num-label { visibility: hidden; }
tr:hover .gantt-num-cell .g-add-btn { display: inline-flex; }
tr:hover .gantt-num-cell .g-add-btn:hover { background: #c8e6c9; }

/* COMMENT INPUT */
.comment-input { width: 100%; padding: 3px 6px; border: 1px solid var(--gray-med);
  border-radius: 3px; font-family: var(--font); font-size: 11px; }
.comment-input:focus { outline: none; border-color: var(--red); }

/* FOOTER */
.app-footer { text-align: center; padding: 12px; font-size: 10px; color: var(--gray);
  border-top: 1px solid var(--gray-med); margin-top: 20px; background: white; }

/* SAVE BADGE */
#save-indicator {
  position: fixed; bottom: 16px; right: 16px; background: var(--green);
  color: white; padding: 8px 16px; border-radius: 20px; font-size: 11px;
  font-weight: 700; display: none; box-shadow: 0 2px 8px rgba(0,0,0,.2);
  z-index: 999;
}

/* GRID 2-COL */
.grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
@media (max-width: 900px) { .grid-2 { grid-template-columns: 1fr; } }

/* SCROLLABLE TABLE */
.table-scroll { overflow-x: auto; }



/* ══════════════════════════════════════════════════
   USER HEADER WIDGET
══════════════════════════════════════════════════ */
.user-widget { display: flex; align-items: center; gap: 8px; }
.role-badge { padding: 3px 10px; border-radius: 12px; font-size: 10px;
  font-weight: 700; text-transform: uppercase; letter-spacing: .5px; }
.role-owner  { background: var(--red); color: white; }
.role-editor { background: var(--orange); color: white; }
.role-viewer { background: var(--gray-med); color: var(--gray); }
.user-name   { font-size: 12px; font-weight: 600; color: var(--black); }
.btn-users   { background: none; border: 1px solid var(--gray-med); color: var(--gray);
  padding: 4px 10px; border-radius: 4px; font-size: 11px; cursor: pointer; }
.btn-users:hover { background: var(--red-light); border-color: var(--red); color: var(--red); }

/* ══════════════════════════════════════════════════
   READONLY BANNER
══════════════════════════════════════════════════ */
/* ══════════════════════════════════════════════════
   VIEWER MODE — disable all editable elements
══════════════════════════════════════════════════ */
/* ══════════════════════════════════════════════════
   SYNC INDICATOR
══════════════════════════════════════════════════ */
#sync-indicator {
  position: fixed; bottom: 16px; left: 16px; background: #1565C0;
  color: white; padding: 8px 16px; border-radius: 20px; font-size: 11px;
  font-weight: 700; display: none; box-shadow: 0 2px 8px rgba(0,0,0,.2); z-index: 999;
}

/* ══════════════════════════════════════════════════
   USER MANAGEMENT MODAL
══════════════════════════════════════════════════ */
.users-box {
  background: white; border-radius: 8px; padding: 0; width: 560px;
  max-height: 80vh; overflow-y: auto; box-shadow: 0 10px 40px rgba(0,0,0,.3);
}
.users-header {
  background: var(--red); color: white; padding: 14px 18px;
  font-weight: 700; font-size: 14px; border-radius: 8px 8px 0 0;
  display: flex; justify-content: space-between; align-items: center;
}
.users-body { padding: 16px 18px; }
.user-row { display: flex; align-items: center; gap: 10px; padding: 10px 0;
  border-bottom: 1px solid #eee; }
.user-row:last-child { border-bottom: none; }
.user-avatar { width: 34px; height: 34px; border-radius: 50%; background: var(--red);
  color: white; display: flex; align-items: center; justify-content: center;
  font-weight: 700; font-size: 13px; flex-shrink: 0; }
.user-info { flex: 1; }
.user-info .u-name { font-weight: 600; font-size: 13px; }
.user-info .u-email { font-size: 11px; color: var(--gray); }
.user-role-select { padding: 4px 8px; border: 1px solid var(--gray-med); border-radius: 4px;
  font-size: 12px; font-family: var(--font); background: white; }
.invite-section { margin-top: 16px; padding-top: 16px; border-top: 2px solid #eee; }
.invite-row { display: flex; gap: 8px; margin-top: 10px; }
.invite-row input { flex: 1; padding: 8px 10px; border: 1px solid var(--gray-med);
  border-radius: 4px; font-size: 12px; font-family: var(--font); }
.invite-row select { padding: 8px; border: 1px solid var(--gray-med);
  border-radius: 4px; font-size: 12px; font-family: var(--font); }
.btn-invite { background: var(--green); color: white; border: none; padding: 8px 14px;
  border-radius: 4px; font-size: 12px; font-weight: 700; cursor: pointer; }


/* Textarea commentaire extensible */
textarea.auto-grow { field-sizing: content; min-height: 36px; }

/* ══════════════════════════════════════════════════
   ONGLET TECHNIQUE
══════════════════════════════════════════════════ */
.tech-subnav {
  display: flex; gap: 0; border-bottom: 2px solid var(--gray-med);
  margin-bottom: 20px;
}
.tech-pill {
  padding: 10px 22px; font-size: 12px; font-weight: 700;
  color: var(--gray); cursor: pointer; background: none; border: none;
  border-bottom: 3px solid transparent; margin-bottom: -2px;
  transition: color .15s, border-color .15s;
}
.tech-pill.active { color: var(--red); border-bottom-color: var(--red); }
.tech-pill:hover:not(.active) { color: var(--black); background: var(--gray-light); }

.tech-kpi-bar { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 18px; }
.tech-kpi {
  background: white; border-radius: 6px; border: 1px solid var(--gray-med);
  padding: 10px 18px; min-width: 90px; text-align: center;
  box-shadow: 0 1px 4px rgba(0,0,0,.04);
}
.tech-kpi-val { font-size: 24px; font-weight: 700; line-height: 1; }
.tech-kpi-lbl { font-size: 10px; color: var(--gray); margin-top: 3px; text-transform: uppercase; letter-spacing: .3px; }

/* Interface cards */
.iface-card {
  background: white; border-radius: 8px; border: 1px solid var(--gray-med);
  margin-bottom: 10px; overflow: hidden;
  box-shadow: 0 1px 4px rgba(0,0,0,.04);
  transition: box-shadow .2s;
}
.iface-card:hover { box-shadow: 0 3px 14px rgba(0,0,0,.09); }
.iface-header {
  display: flex; align-items: center; gap: 10px;
  padding: 12px 16px; cursor: pointer;
  border-left: 5px solid var(--gray-med); user-select: none;
}
.iface-header.s-done     { border-left-color: var(--green); }
.iface-header.s-partial  { border-left-color: var(--orange); }
.iface-header.s-pending_boa, .iface-header.s-pending_cbs { border-left-color: #90b3f7; }
.iface-name { font-size: 13px; font-weight: 700; flex: 1; min-width: 0; }
.iface-chevron { font-size: 13px; color: var(--gray); margin-left: 4px; transition: transform .2s; }
.iface-chevron.open { transform: rotate(180deg); }
.iface-body {
  padding: 0 16px 16px 21px;
  border-top: 1px solid #f2f2f2; display: none;
}
.iface-body.open { display: block; }

/* Badge helpers */
.tbadge {
  padding: 2px 8px; border-radius: 10px; font-size: 10px; font-weight: 700;
  text-transform: uppercase; letter-spacing: .3px; white-space: nowrap;
  display: inline-block;
}
.tb-done     { background: #e8f5ed; color: #2e7d52; border: 1px solid #a8d5b5; }
.tb-partial  { background: var(--orange-light); color: var(--orange); border: 1px solid #f5ba80; }
.tb-pending  { background: #e8f0fe; color: #1565C0; border: 1px solid #90b3f7; }
.tb-no-impact  { background: #e8f5ed; color: #2e7d52; }
.tb-1-impact   { background: var(--orange-light); color: var(--orange); }
.tb-multi      { background: var(--red-light); color: var(--red); }
.tb-tbd        { background: var(--gray-light); color: var(--gray); }

/* Inline editing inputs inside table */
.iface-inline-input {
  border: 1px solid transparent; background: transparent; font-size: 12px;
  width: 100%; padding: 3px 5px; border-radius: 4px; outline: none; color: #222;
  font-family: inherit; transition: background .12s, border-color .12s;
}
.iface-inline-input:hover  { background: #f4f7ff; border-color: #c5d4f8; }
.iface-inline-input:focus  { background: #eef3ff; border-color: #90b3f7; box-shadow: 0 0 0 2px #dde8ff; }
.iface-inline-input::placeholder { color: #ccc; }
.iface-inline-select {
  border: 1px solid transparent; background: transparent; font-size: 11px;
  padding: 3px 4px; border-radius: 4px; outline: none; cursor: pointer;
  width: 100%; font-family: inherit; transition: background .12s, border-color .12s;
}
.iface-inline-select:hover  { background: #f4f7ff; border-color: #c5d4f8; }
.iface-inline-select:focus  { background: #eef3ff; border-color: #90b3f7; }
.iface-comment-line {
  display: flex; align-items: flex-start; gap: 3px; margin-bottom: 3px;
}
.iface-comment-line-text {
  font-size: 10px; color: #555; flex: 1; line-height: 1.4; word-break: break-word;
}
.iface-comment-del {
  background: none; border: none; cursor: pointer; color: #ccc;
  font-size: 11px; padding: 0 1px; line-height: 1; flex-shrink: 0;
  transition: color .1s;
}
.iface-comment-del:hover { color: var(--red); }

/* Interface table */
.iface-table {
  width: 100%; border-collapse: collapse; font-size: 12px;
  background: white; border-radius: 8px; overflow: hidden;
  box-shadow: 0 1px 4px rgba(0,0,0,.05);
}
.iface-table thead th {
  background: #f5f6f8; padding: 10px 12px;
  text-align: left; font-size: 10px; font-weight: 700;
  color: var(--gray); text-transform: uppercase; letter-spacing: .5px;
  border-bottom: 2px solid var(--gray-med); white-space: nowrap;
}
.iface-table tbody tr.iface-row {
  border-bottom: 1px solid #f2f2f2; cursor: pointer;
  transition: background .12s;
}
.iface-table tbody tr.iface-row:hover { background: #f8fbff; }
.iface-table tbody tr.iface-row td { padding: 10px 12px; vertical-align: middle; }
.iface-row-status-bar { display: inline-block; width: 4px; height: 26px; border-radius: 2px; vertical-align: middle; margin-right: 8px; }
.iface-detail-cell {
  padding: 0 !important; background: #f8fbff;
  border-bottom: 2px solid #dce8ff !important;
}
.iface-detail-inner {
  display: none; padding: 14px 16px 14px 22px;
}

/* ── Status select coloring (via data-status attribute) ─────── */
.iface-inline-select[data-status="done"]        { background:#ecfdf5; color:#065f46; border-color:#6ee7b7 !important; font-weight:600; }
.iface-inline-select[data-status="partial"]     { background:#fffbeb; color:#92400e; border-color:#fcd34d !important; font-weight:600; }
.iface-inline-select[data-status="pending_boa"] { background:#fef2f2; color:#991b1b; border-color:#fca5a5 !important; font-weight:600; }
.iface-inline-select[data-status="pending_cbs"] { background:#f5f3ff; color:#5b21b6; border-color:#c4b5fd !important; font-weight:600; }

/* ── Impact select coloring ──────────────────────────────────── */
.iface-inline-select[data-impact="no_impact"] { background:#f0fdf4; color:#166534; border-color:#86efac !important; }
.iface-inline-select[data-impact="minor"]     { background:#fffbeb; color:#92400e; border-color:#fcd34d !important; }
.iface-inline-select[data-impact="multiple"]  { background:#fff7ed; color:#9a3412; border-color:#fdba74 !important; }
.iface-inline-select[data-impact="tbd"]       { background:#f9fafb; color:#6b7280; border-color:#d1d5db !important; }

/* ── Editable comment text ───────────────────────────────────── */
.iface-cmt-edit {
  cursor: text; padding: 1px 4px; border-radius: 3px;
  min-width: 20px; display: inline; word-break: break-word;
  transition: background .15s; outline: none;
}
.iface-cmt-edit:hover  { background: #e8f0ff; }
.iface-cmt-edit:focus  { background: #eef3ff; outline: 1px solid #90b3f7; border-radius: 3px; }

/* Comments */
.iface-comment {
  font-size: 11px; color: #444; padding: 6px 10px;
  background: #fafafa; border-left: 3px solid var(--gray-med);
  margin-bottom: 4px; border-radius: 0 4px 4px 0; line-height: 1.5;
}

/* ── Périmètre modules table ────────────────────────────────────────── */
.perim-domaine-cell {
  font-weight: 700; font-size: 11px; color: #1565C0;
  background: #e8f0fe; border-radius: 4px; padding: 2px 6px;
  white-space: nowrap; display: inline-block;
}
.perim-version-badge {
  display: inline-block; font-size: 11px; font-weight: 700;
  border-radius: 4px; padding: 2px 7px; white-space: nowrap;
}
.perim-v2  { background: #fff3cd; color: #856404; border: 1px solid #ffc107; }
.perim-v4  { background: #d1e7dd; color: #0a3622; border: 1px solid #198754; }
.perim-arrow-up   { color: #22c55e; font-size: 15px; font-weight: 900; }
.perim-arrow-down { color: #ef4444; font-size: 15px; font-weight: 900; }
.perim-cmt-edit {
  cursor: text; padding: 3px 6px; border-radius: 4px;
  min-width: 20px; display: block; word-break: break-word;
  transition: background .15s; outline: none; font-size: 12px;
  min-height: 22px; line-height: 1.5;
}
.perim-cmt-edit:empty::before { content: attr(data-placeholder); color: #bbb; font-style: italic; }
.perim-cmt-edit:hover  { background: #f0f4ff; }
.perim-cmt-edit:focus  { background: #eef3ff; outline: 1px solid #90b3f7; }
.impact-aucun  { color: #166534; background: #dcfce7; padding: 2px 6px; border-radius: 4px; font-size: 11px; white-space: nowrap; }
.impact-mineur { color: #854d0e; background: #fef9c3; padding: 2px 6px; border-radius: 4px; font-size: 11px; white-space: nowrap; }
.impact-moyen  { color: #9a3412; background: #ffedd5; padding: 2px 6px; border-radius: 4px; font-size: 11px; white-space: nowrap; }
.impact-majeur { color: #fff; background: #1c1c1c; padding: 2px 6px; border-radius: 4px; font-size: 11px; white-space: nowrap; }
/* ── Vue Kanban ──────────────────────────────────────────────────────── */
.view-toggle-bar {
  display: flex; align-items: center; gap: 4px;
  background: #f0f2f5; border-radius: 7px; padding: 3px; flex-shrink: 0;
}
.view-toggle-btn {
  border: none; border-radius: 5px; padding: 4px 13px; font-size: 11px;
  font-weight: 600; cursor: pointer; transition: all .15s; background: transparent; color: #54565A;
}
.view-toggle-btn.active { background: #fff; color: #E63329; box-shadow: 0 1px 4px rgba(0,0,0,.13); }
.view-toggle-btn:not(.active):hover { background: #e5e7eb; }
.kanban-board {
  display: flex; gap: 12px; padding: 12px 16px 16px; overflow-x: auto; align-items: flex-start; min-height: 200px;
}
.kanban-col {
  flex: 0 0 230px; background: #f4f6f9; border-radius: 10px; overflow: hidden;
  border: 1px solid #e5e7eb; display: flex; flex-direction: column;
}
.kanban-col-header {
  padding: 9px 12px 8px; display: flex; align-items: center; justify-content: space-between;
  border-bottom: 1px solid rgba(255,255,255,.25);
}
.kanban-col-title { font-size: 12px; font-weight: 700; color: #fff; }
.kanban-col-badge {
  background: rgba(255,255,255,.3); color: #fff; border-radius: 9px;
  padding: 1px 7px; font-size: 10px; font-weight: 700; min-width: 18px; text-align: center;
}
.kanban-col-body { padding: 8px; display: flex; flex-direction: column; gap: 6px; flex: 1; min-height: 60px; }
.kanban-card {
  background: #fff; border-radius: 7px; padding: 9px 11px; border: 1px solid #e8eaed;
  box-shadow: 0 1px 3px rgba(0,0,0,.06); cursor: default; transition: box-shadow .15s;
}
.kanban-card:hover { box-shadow: 0 3px 10px rgba(0,0,0,.12); }
.kanban-card-title { font-size: 11px; font-weight: 600; color: #1a1a1a; line-height: 1.4; margin-bottom: 5px; }
.kanban-card-meta { display: flex; flex-wrap: wrap; gap: 3px; margin-top: 5px; }
.kanban-badge {
  font-size: 9px; font-weight: 700; border-radius: 3px; padding: 1px 5px;
  white-space: nowrap; display: inline-block;
}
.kanban-empty { text-align: center; color: #bbb; font-size: 11px; padding: 20px 8px; }

/* ── Analyse TCD ─────────────────────────────────────────────────────── */
.tcd-preset {
  background: #f0f4ff; border: 1px solid #c5d8ff; color: #1565C0;
  border-radius: 12px; padding: 3px 10px; font-size: 11px; font-weight: 600;
  cursor: pointer; white-space: nowrap; transition: all .15s;
}
.tcd-preset:hover { background: #1565C0; color: #fff; border-color: #1565C0; }
.tcd-table { border-collapse: collapse; font-size: 12px; width: 100%; min-width: 400px; }
.tcd-table th {
  background: #E63329; color: #fff; padding: 6px 12px; text-align: center;
  font-weight: 700; font-size: 11px; border: 1px solid #c0392b; white-space: nowrap;
}
.tcd-table th.tcd-th-row { background: #54565A; text-align: left; }
.tcd-table th.tcd-th-total { background: #333; }
.tcd-table td {
  padding: 5px 12px; border: 1px solid #e5e7eb; text-align: center;
  font-size: 12px; color: #333; white-space: nowrap;
}
.tcd-table td.tcd-row-header {
  text-align: left; font-weight: 700; color: #1a1a1a;
  background: #f8f9fa; border-right: 2px solid #e5e7eb;
}
.tcd-table td.tcd-total-row { font-weight: 700; background: #f0f4ff; color: #1565C0; }
.tcd-table td.tcd-total-col { font-weight: 700; background: #f8f9fa; color: #333; }
.tcd-table td.tcd-grand-total { font-weight: 900; background: #1565C0; color: #fff; }
.tcd-table tr:hover td:not(.tcd-row-header):not(.tcd-total-row):not(.tcd-total-col):not(.tcd-grand-total) { filter: brightness(0.93); }
.tcd-heat-0  { background: #f9fafb; }
.tcd-heat-1  { background: #dbeafe; }
.tcd-heat-2  { background: #bfdbfe; }
.tcd-heat-3  { background: #93c5fd; }
.tcd-heat-4  { background: #60a5fa; color: #fff; }
.tcd-heat-5  { background: #3b82f6; color: #fff; }
.tcd-heat-6  { background: #2563eb; color: #fff; }
.tcd-heat-7  { background: #1d4ed8; color: #fff; }

/* Editable select in perimetre table */
.perim-select {
  font-size: 11px; padding: 2px 5px; border: 1px solid #ddd; border-radius: 4px;
  cursor: pointer; background: white; transition: border-color .15s;
}
.perim-select:hover { border-color: #7c3aed; }
.perim-select:focus { outline: none; border-color: #7c3aed; box-shadow: 0 0 0 2px #ede9fe; }
.perim-select[data-imp="aucun"]  { background: #dcfce7; color: #166534; border-color: #bbf7d0; }
.perim-select[data-imp="mineur"] { background: #fef9c3; color: #854d0e; border-color: #fde68a; }
.perim-select[data-imp="moyen"]  { background: #ffedd5; color: #9a3412; border-color: #fdba74; }
.perim-select[data-imp="majeur"] { background: #1c1c1c; color: #fff;    border-color: #444;    }
.perim-select[data-bm="V4"]      { background: #d1e7dd; color: #0a3622; border-color: #a3cfbb; font-weight: 700; }
.perim-select[data-bm="V2"]      { background: #fff3cd; color: #856404; border-color: #ffd97d; font-weight: 700; }
/* Périmètre KPI mini-card */
.perim-kpi-mini {
  flex: 1; min-width: 100px; text-align: center; padding: 10px 12px;
  border-radius: 8px; border: 1px solid; display: flex; flex-direction: column;
  align-items: center; gap: 2px;
}
.perim-kpi-mini .pk-val  { font-size: 22px; font-weight: 900; line-height: 1; }
.perim-kpi-mini .pk-lbl  { font-size: 10px; font-weight: 600; }
.perim-kpi-mini .pk-sub  { font-size: 9px; opacity: .7; }
/* ── Gantt reference plan delta ─────────────────────────────────────── */
.gantt-ref-date { display: block; font-size: 9px; color: #9ca3af; text-decoration: line-through; margin-top: 1px; }
.gantt-delta-pos { font-size: 9px; color: #ef4444; font-weight: 700; }
.gantt-delta-neg { font-size: 9px; color: #22c55e; font-weight: 700; }
/* Actions in technique tab */
.tech-actions-header {
  display: flex; align-items: center; justify-content: space-between;
  margin-top: 14px; margin-bottom: 8px;
}
.tech-sect-label {
  font-size: 10px; font-weight: 700; color: var(--gray);
  text-transform: uppercase; letter-spacing: .5px;
}
.tech-action-row {
  background: var(--gray-light); border-radius: 6px; padding: 10px 12px;
  margin-bottom: 6px; display: flex; gap: 8px; align-items: flex-start;
  border: 1px solid transparent; transition: border-color .15s;
}
.tech-action-row:hover { border-color: var(--gray-med); background: #f8f8f8; }
.tech-action-left { flex: 1; min-width: 0; }
.tech-action-desc { font-size: 12px; font-weight: 600; }
.tech-action-meta { font-size: 10px; color: var(--gray); margin-top: 3px; display: flex; gap: 8px; flex-wrap: wrap; }
.tech-action-controls { display: flex; gap: 5px; align-items: center; flex-shrink: 0; }

/* Arbitrage chips */
.arb-chip {
  padding: 2px 7px; border-radius: 10px; font-size: 10px; font-weight: 700;
  cursor: pointer; border: 1px solid transparent; transition: opacity .15s;
}
.arb-chip:hover { opacity: .8; }
.arb-pending   { background: #fff8e1; color: #e65100; border-color: #ffb74d; }
.arb-submitted { background: #e8f0fe; color: #1565C0; border-color: #90b3f7; }
.arb-validated { background: #e8f5ed; color: #2e7d52; border-color: #a8d5b5; }
.arb-rejected  { background: var(--red-light); color: var(--red); border-color: #f5a5a0; }

/* Status select small */
.tech-select {
  padding: 3px 6px; border: 1px solid var(--gray-med); border-radius: 4px;
  font-size: 11px; font-family: var(--font); background: white; cursor: pointer;
  outline: none;
}
.tech-btn-sm {
  padding: 3px 8px; border-radius: 4px; font-size: 10px; font-weight: 700;
  border: 1px solid var(--gray-med); background: white; cursor: pointer;
  transition: background .12s;
}
.tech-btn-sm:hover { background: var(--gray-light); }
.tech-btn-sm.red  { color: var(--red); border-color: var(--red); }
.tech-btn-sm.red:hover { background: var(--red-light); }
.tech-btn-sm.green { color: var(--green); border-color: var(--green); }
.tech-btn-sm.green:hover { background: var(--green-light); }
.tech-btn-add {
  padding: 5px 12px; background: var(--red); color: white;
  border: none; border-radius: 4px; font-size: 11px; font-weight: 700;
  cursor: pointer;
}
.tech-btn-add:hover { background: var(--red-dark); }

/* Architecture section */
.env-pipeline {
  display: flex; border: 1px solid var(--gray-med); border-radius: 8px;
  overflow: hidden; margin-bottom: 20px; background: white;
}
.env-stage {
  flex: 1; padding: 13px 10px; text-align: center; cursor: pointer;
  border-right: 1px solid var(--gray-med); transition: background .15s;
  position: relative;
}
.env-stage:last-child { border-right: none; }
.env-stage.active { background: var(--red); color: white; }
.env-stage:not(.active):hover { background: var(--red-light); color: var(--red); }
.env-stage-name { font-size: 13px; font-weight: 700; }
.env-stage-count { font-size: 10px; opacity: .65; margin-top: 2px; }
.env-stage-arrow {
  position: absolute; right: -10px; top: 50%; transform: translateY(-50%);
  width: 20px; height: 20px; background: var(--gray-light);
  clip-path: polygon(0 0, 60% 50%, 0 100%); z-index: 1;
}

.archi-card {
  background: white; border-radius: 8px;
  border: 1px solid var(--gray-med); border-left: 5px solid #90b3f7;
  padding: 14px 16px; margin-bottom: 10px;
  box-shadow: 0 1px 4px rgba(0,0,0,.04);
}
.archi-card.domain-infra  { border-left-color: #1565C0; }
.archi-card.domain-data   { border-left-color: var(--orange); }
.archi-card.domain-secu   { border-left-color: var(--red); }
.archi-card.domain-reseau { border-left-color: var(--green); }
.archi-card.domain-autre  { border-left-color: var(--gray); }
.archi-header { display: flex; align-items: flex-start; gap: 10px; }
.archi-title { font-size: 13px; font-weight: 700; flex: 1; }
.archi-desc  { font-size: 11px; color: var(--gray); margin-top: 6px; line-height: 1.55; }

/* Inline add form */
.tech-inline-form {
  background: #f7f9ff; border: 1px dashed #90b3f7; border-radius: 6px;
  padding: 12px 14px; margin-top: 8px;
}
.tech-inline-form input, .tech-inline-form select, .tech-inline-form textarea {
  padding: 7px 10px; border: 1px solid var(--gray-med); border-radius: 4px;
  font-size: 12px; font-family: var(--font); outline: none; width: 100%;
  box-sizing: border-box;
}
.tech-inline-form input:focus, .tech-inline-form select:focus,
.tech-inline-form textarea:focus { border-color: var(--red); }
.tech-inline-grid { display: grid; gap: 8px; }


/* ═══ RÔLES & READER MODE ══════════════════════════════════════════════════ */
.role-badge.role-admin { background: #5C35D4; color: #fff; border: 1px solid #4527A0; }
/* En mode lecture : cacher les contrôles d'édition recréés dynamiquement */
body.reader-mode .editor-only,
body.reader-mode .owner-only { display: none !important; }
body.reader-mode .admin-only  { display: none !important; }
body.reader-mode .status-select,
body.reader-mode .comment-input,
body.reader-mode .rag-btn,
body.reader-mode .prog-input { pointer-events: none !important; opacity: .7; cursor: not-allowed !important; }
body.reader-mode .btn-save    { display: none !important; }

/* ═══ KANBAN DRAG & DROP ═══════════════════════════════════════════════════ */
.kanban-card-draggable { cursor: grab; transition: box-shadow .15s, transform .15s; }
.kanban-card-draggable:active { cursor: grabbing; }
.kanban-card-dragging  { opacity: .35; transform: rotate(1.5deg) scale(.97); box-shadow: 0 8px 24px rgba(0,0,0,.2); }
.kanban-col-dragover .kanban-col-body {
  background: #EEF6FF !important;
  outline: 2px dashed #1565C0;
  outline-offset: -4px;
  border-radius: 0 0 6px 6px;
}
.kanban-col-dragover .kanban-col-header { filter: brightness(1.12); }

/* ── Bloc 2 ── */
/* ══════════════════════════════════════════════════
   LOGIN OVERLAY
══════════════════════════════════════════════════ */
#login-overlay {
  position: fixed; inset: 0; z-index: 9999;
  background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%);
  display: flex; align-items: center; justify-content: center;
}
#login-overlay.hidden { display: none; }

.login-box {
  background: #fff; border-radius: 8px;
  box-shadow: 0 24px 64px rgba(0,0,0,.45);
  padding: 40px 40px 36px;
  width: 340px; max-width: 94vw;
  display: flex; flex-direction: column; gap: 0;
}
.login-logo {
  background: var(--red); border-radius: 4px;
  color: #fff; font-weight: 700; font-size: 13px;
  letter-spacing: 1.5px; text-align: center;
  padding: 10px 0; margin-bottom: 6px;
}
.login-app-title {
  font-size: 12px; color: var(--gray); text-align: center;
  margin-bottom: 28px; line-height: 1.5;
}
.login-label {
  font-size: 11px; font-weight: 700; color: var(--gray);
  text-transform: uppercase; letter-spacing: .4px;
  margin-bottom: 5px; margin-top: 14px;
  display: block;
}
.login-label:first-of-type { margin-top: 0; }
.login-input {
  width: 100%; padding: 9px 12px;
  border: 1px solid var(--gray-med); border-radius: 4px;
  font-size: 13px; font-family: var(--font);
  outline: none; transition: border-color .15s;
  box-sizing: border-box;
}
.login-input:focus { border-color: var(--red); }
.login-error {
  font-size: 11px; color: var(--red); text-align: center;
  min-height: 16px; margin-top: 10px;
}
.login-btn {
  margin-top: 20px; width: 100%; padding: 11px;
  background: var(--red); color: #fff; border: none;
  border-radius: 4px; font-size: 13px; font-weight: 700;
  cursor: pointer; letter-spacing: .3px;
  transition: background .15s;
}
.login-btn:hover { background: var(--red-dark); }
.login-btn:disabled { background: var(--gray-med); cursor: default; }
.login-footer {
  font-size: 10px; color: var(--gray-med); text-align: center;
  margin-top: 20px; cursor: default; user-select: none;
}

/* ── BOOTSTRAP ADMIN PANEL ── */
#bootstrap-overlay {
  position: fixed; inset: 0; z-index: 10005;
  background: rgba(0,0,0,.7);
  display: flex; align-items: center; justify-content: center;
}
#bootstrap-overlay.hidden { display: none; }
.bootstrap-box {
  background: #fff; border-radius: 10px;
  width: 520px; max-width: 96vw; max-height: 92vh; overflow-y: auto;
  box-shadow: 0 24px 64px rgba(0,0,0,.4);
}
.bootstrap-header {
  background: #1F3864; color: #fff;
  padding: 16px 22px; border-radius: 10px 10px 0 0;
  display: flex; align-items: center; gap: 10px;
}
.bootstrap-header h3 { font-size: 14px; font-weight: 700; flex: 1; }
.bootstrap-close {
  background: none; border: none; color: #fff;
  font-size: 20px; cursor: pointer; opacity: .7; line-height: 1;
}
.bootstrap-close:hover { opacity: 1; }
.bootstrap-body { padding: 22px 24px; }
.bootstrap-alert {
  background: #fff8e1; border: 1px solid #f9a825;
  border-radius: 6px; padding: 10px 14px;
  font-size: 11px; color: #5d4037; margin-bottom: 18px; line-height: 1.6;
}
.bootstrap-form { display: grid; gap: 10px; margin-bottom: 16px; }
.bootstrap-label { font-size: 11px; font-weight: 700; color: #54565A; margin-bottom: 3px; display: block; }
.bootstrap-input {
  padding: 8px 10px; border: 1px solid #ccc; border-radius: 4px;
  font-size: 12px; width: 100%; box-sizing: border-box; outline: none; font-family: inherit;
}
.bootstrap-input:focus { border-color: #1F3864; }
.bootstrap-gen-btn {
  padding: 10px 20px; background: #1F3864; color: #fff;
  border: none; border-radius: 5px; font-size: 13px; font-weight: 700;
  cursor: pointer; width: 100%; margin-bottom: 16px;
}
.bootstrap-gen-btn:hover { background: #162a4e; }
#bootstrap-sql-block {
  background: #1e1e2e; color: #cdd6f4; border-radius: 6px;
  padding: 14px 16px; font-size: 11px; font-family: monospace;
  white-space: pre-wrap; word-break: break-all; line-height: 1.6;
  max-height: 280px; overflow-y: auto;
}
.bootstrap-copy-btn {
  margin-top: 10px; padding: 8px 18px; width: 100%;
  background: #f5f5f5; border: 1px solid #ccc;
  border-radius: 4px; font-size: 12px; cursor: pointer; font-weight: 700;
}
.bootstrap-copy-btn:hover { background: #e8f5e9; border-color: #4caf50; }
.bootstrap-steps {
  margin-top: 16px; padding: 12px 14px;
  background: #f0f4ff; border-radius: 6px;
  font-size: 11px; color: #333; line-height: 1.8;
  border-left: 3px solid #1F3864;
}
.bootstrap-steps strong { color: #1F3864; }

/* ── CHANGE PASSWORD OVERLAY ── */
#change-password-overlay {
  position: fixed; inset: 0; z-index: 10000;
  background: rgba(0,0,0,.65);
  display: flex; align-items: center; justify-content: center;
}
#change-password-overlay.hidden { display: none; }
.chpwd-box {
  background: #fff; border-radius: 8px;
  box-shadow: 0 24px 64px rgba(0,0,0,.35);
  padding: 36px 40px 32px;
  width: 340px; max-width: 94vw;
}
.chpwd-title {
  font-size: 15px; font-weight: 700; color: var(--black);
  margin-bottom: 6px;
}
.chpwd-subtitle {
  font-size: 11px; color: var(--gray); margin-bottom: 22px;
}
.chpwd-input {
  width: 100%; padding: 9px 12px;
  border: 1px solid var(--gray-med); border-radius: 4px;
  font-size: 13px; font-family: var(--font);
  outline: none; transition: border-color .15s;
  box-sizing: border-box; margin-bottom: 2px;
}
.chpwd-input:focus { border-color: var(--red); }
.chpwd-error {
  font-size: 11px; color: var(--red); min-height: 16px;
  text-align: center; margin-top: 10px;
}
.chpwd-btn {
  margin-top: 18px; width: 100%; padding: 11px;
  background: var(--red); color: #fff; border: none;
  border-radius: 4px; font-size: 13px; font-weight: 700;
  cursor: pointer; transition: background .15s;
}
.chpwd-btn:hover { background: var(--red-dark); }
.chpwd-btn:disabled { background: var(--gray-med); cursor: default; }
.chpwd-cancel {
  background: none; border: none; color: var(--gray);
  font-size: 12px; cursor: pointer; width: 100%;
  text-align: center; margin-top: 10px; text-decoration: underline;
}

/* ── USER MANAGEMENT MODAL ── */
#user-mgmt-modal {
  position: fixed; inset: 0; z-index: 10000;
  background: rgba(0,0,0,.55);
  display: flex; align-items: flex-start; justify-content: center;
  padding: 40px 16px;
  overflow-y: auto;
}
#user-mgmt-modal.hidden { display: none; }
#login-logs-modal.hidden { display: none !important; }
#relance-modal.hidden { display: none !important; }
.umgmt-box {
  background: #fff; border-radius: 8px;
  box-shadow: 0 24px 64px rgba(0,0,0,.3);
  width: 780px; max-width: 100%;
  padding: 0; overflow: hidden;
}
.umgmt-header {
  background: var(--red); color: #fff;
  padding: 16px 24px; display: flex;
  align-items: center; justify-content: space-between;
}
.umgmt-header h2 { font-size: 15px; font-weight: 700; }
.umgmt-close {
  background: none; border: none; color: #fff;
  font-size: 20px; cursor: pointer; line-height: 1; opacity: .8;
}
.umgmt-close:hover { opacity: 1; }
.umgmt-body { padding: 24px; }
.umgmt-section-title {
  font-size: 12px; font-weight: 700; color: var(--gray);
  text-transform: uppercase; letter-spacing: .4px;
  margin-bottom: 12px; margin-top: 20px;
}
.umgmt-section-title:first-child { margin-top: 0; }
.umgmt-table {
  width: 100%; border-collapse: collapse;
  font-size: 12px;
}
.umgmt-table th {
  text-align: left; padding: 8px 10px;
  background: var(--gray-light); color: var(--gray);
  font-size: 10px; font-weight: 700; text-transform: uppercase;
  letter-spacing: .3px; border-bottom: 1px solid var(--gray-med);
}
.umgmt-table td { vertical-align: middle; }
.umgmt-add-form {
  display: grid; grid-template-columns: 1fr 1fr 1fr 110px 90px; gap: 8px;
  align-items: end; margin-top: 12px;
}
.umgmt-add-form input, .umgmt-add-form select {
  padding: 8px 10px; border: 1px solid var(--gray-med);
  border-radius: 4px; font-size: 12px; font-family: var(--font);
  width: 100%; box-sizing: border-box; outline: none;
}
.umgmt-add-form input:focus, .umgmt-add-form select:focus {
  border-color: var(--red);
}
.umgmt-add-btn {
  padding: 8px 12px; background: var(--red); color: #fff;
  border: none; border-radius: 4px; font-size: 12px; font-weight: 700;
  cursor: pointer; white-space: nowrap;
}
.umgmt-add-btn:hover { background: var(--red-dark); }
.umgmt-add-error { font-size: 11px; color: var(--red); margin-top: 6px; min-height: 14px; }

/* ── RESET RESULT MODAL ── */
#reset-result-modal {
  position: fixed; inset: 0; z-index: 10001;
  background: rgba(0,0,0,.6);
  display: flex; align-items: center; justify-content: center;
}
#reset-result-modal.hidden { display: none; }
.reset-box {
  background: #fff; border-radius: 8px;
  padding: 28px 32px 24px; width: 440px; max-width: 96vw;
  box-shadow: 0 20px 56px rgba(0,0,0,.3);
  text-align: center;
}
.reset-icon { font-size: 32px; margin-bottom: 10px; }
.reset-box h3 { font-size: 15px; font-weight: 700; margin-bottom: 6px; }
.reset-box p  { font-size: 12px; color: var(--gray); margin-bottom: 16px; }
.reset-pwd-display {
  background: var(--gray-light); border: 1px dashed var(--gray-med);
  border-radius: 4px; padding: 12px 14px;
  font-size: 16px; font-weight: 700; letter-spacing: 1px;
  font-family: monospace; text-align: center; width: 100%;
  box-sizing: border-box; color: var(--black);
  cursor: text; user-select: all;
}
.reset-copy-btn {
  margin-top: 10px; padding: 8px 20px;
  background: var(--gray-light); border: 1px solid var(--gray-med);
  border-radius: 4px; font-size: 12px; cursor: pointer;
}
.reset-copy-btn:hover { background: var(--green-light); border-color: var(--green); }
.reset-close-btn {
  margin-top: 14px; width: 100%; padding: 10px;
  background: var(--red); color: #fff; border: none;
  border-radius: 4px; font-size: 13px; font-weight: 700; cursor: pointer;
}
.reset-close-btn:hover { background: var(--red-dark); }
.reset-outlook-btn {
  flex: 1; padding: 8px 14px;
  background: #0078d4; color: #fff; border: none;
  border-radius: 4px; font-size: 12px; font-weight: 700; cursor: pointer;
}
.reset-outlook-btn:hover { background: #006abc; }
.reset-email-input {
  padding: 8px 10px; border: 1px solid #ddd; border-radius: 4px;
  font-size: 12px; width: 100%; box-sizing: border-box; outline: none;
  margin-top: 8px;
}
.reset-email-input:focus { border-color: var(--red); }
.reset-label { font-size: 11px; color: #888; font-weight: 700; display: block; text-align: left; margin-top: 12px; margin-bottom: 3px; }

/* ── TOAST NOTIFICATION ── */
#toast-notif {
  position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%);
  background: #333; color: #fff; padding: 10px 22px;
  border-radius: 20px; font-size: 12px; z-index: 20000;
  opacity: 0; transition: opacity .3s; pointer-events: none;
}
#toast-notif.show { opacity: 1; }

/* ── Permissions par utilisateur ─────────────────────────────────────────── */
body.perm-no-export     .perm-export     { display: none !important; }
body.perm-no-user-mgmt  .perm-user-mgmt  { display: none !important; }
body.perm-no-add-delete .perm-add-delete { display: none !important; }
/* perm-no-edit : canEdit() retourne false → les boutons .editor-only sont déjà masqués */
#permissions-modal.hidden { display: none !important; }

/* ══════════════════════════════════════════════════════════════════════════
   LAYOUT — SIDEBAR MODE
   ══════════════════════════════════════════════════════════════════════════ */

/* Wrapper flex row: sidebar + content */
#app-layout { display: flex; align-items: stretch; }

/* Sidebar nav — hidden by default */
#sidebar-nav {
  display: none;
  flex-direction: column;
  width: 210px;
  min-width: 210px;
  background: var(--white);
  border-right: 1px solid var(--gray-med);
  position: sticky;
  top: 60px;              /* height of app-header */
  height: calc(100vh - 60px);
  overflow-y: auto;
  overflow-x: hidden;
  flex-shrink: 0;
  z-index: 50;
}
.sidebar-logo {
  padding: 12px 10px 8px;
  border-bottom: 1px solid var(--gray-med);
  margin-bottom: 4px;
}
.sidebar-section-title {
  font-size: 9px;
  font-weight: 700;
  color: var(--gray);
  padding: 8px 14px 4px;
  letter-spacing: .7px;
  text-transform: uppercase;
}
#sidebar-nav .tab-btn {
  display: flex;
  align-items: center;
  gap: 8px;
  width: 100%;
  padding: 9px 14px;
  text-align: left;
  font-size: 12px;
  border: none;
  border-left: 3px solid transparent;
  border-bottom: none !important;   /* override tabs-nav style */
  border-radius: 0;
  margin-bottom: 0;
  background: none;
  color: var(--gray);
  transition: all .15s;
}
#sidebar-nav .tab-btn:hover {
  background: var(--red-light);
  color: var(--red);
  border-left-color: transparent;
}
#sidebar-nav .tab-btn.active {
  background: var(--red-light);
  color: var(--red);
  border-left-color: var(--red);
  font-weight: 700;
}
#sidebar-nav .tab-btn .tab-icon { font-size: 14px; flex-shrink: 0; }

/* In sidebar layout mode */
body.layout-sidebar #sidebar-nav { display: flex; }
body.layout-sidebar .tabs-nav .tab-btn { display: none !important; }
body.layout-sidebar .tabs-nav { border-bottom-color: var(--gray-med); padding: 0 12px; }
body.layout-sidebar #main-content { flex: 1; min-width: 0; overflow-x: hidden; }
body.layout-sidebar .tab-content { max-width: none; }

/* ══════════════════════════════════════════════════════════════════════════
   DARK MODE
   ══════════════════════════════════════════════════════════════════════════ */
body.dark-mode {
  --white: #1e2130;
  --black: #e8eaf2;
  --gray: #8890a8;
  --gray-light: #252838;
  --gray-med: #2e3147;
  --red-light: #2d1215;
  --orange-light: #2a1b0c;
  --green-light: #0e2018;
  background: #131520 !important;
  color: #e8eaf2;
}
body.dark-mode .app-header {
  background: #1a1d2b;
  border-bottom-color: var(--red);
  box-shadow: 0 2px 8px rgba(0,0,0,.5);
}
body.dark-mode .header-title h1 { color: #e8eaf2; }
body.dark-mode .header-title p  { color: #8890a8; }
body.dark-mode .today-badge     { background: #252838; color: #8890a8; border-color: #2e3147; }
body.dark-mode .user-widget     { color: #c0c4d8; }
body.dark-mode .btn-users       { background: #252838 !important; color: #b0b8d0 !important; border-color: #2e3147 !important; }

body.dark-mode .tabs-nav { background: #1a1d2b; border-bottom-color: #2e3147; }
body.dark-mode .tab-btn  { color: #8890a8; }
body.dark-mode .tab-btn:hover  { color: var(--red); background: #2d1215; }
body.dark-mode .tab-btn.active { color: var(--red); background: #1a1d2b; border-bottom-color: var(--red); }

body.dark-mode #sidebar-nav    { background: #1a1d2b; border-right-color: #2e3147; }
body.dark-mode #sidebar-nav .tab-btn.active { background: #2d1215; }
body.dark-mode #sidebar-nav .tab-btn:hover  { background: #2d1215; }
body.dark-mode .sidebar-logo   { border-bottom-color: #2e3147; }
body.dark-mode .sidebar-section-title { color: #5a6080; }

body.dark-mode .section-card   { background: #1e2130; box-shadow: 0 1px 4px rgba(0,0,0,.4); }
body.dark-mode .section-header { background: #b82820; }
body.dark-mode .section-body   { background: #1e2130; }

body.dark-mode .data-table th  { background: #b82820; }
body.dark-mode .data-table td  { border-bottom-color: #2e3147; color: #e0e2ec; background: #1e2130; }
body.dark-mode .data-table tr:nth-child(even) td { background: #232640; }
body.dark-mode .data-table tr:hover td           { background: #2a1215; }

body.dark-mode .kpi-red    { background: #b82820; }
body.dark-mode .kpi-dark   { background: #8a1e18; }
body.dark-mode .kpi-orange { background: #b85a1a; }
body.dark-mode .kpi-gray   { background: #3a3f56; }
body.dark-mode .kpi-green  { background: #1a5e3a; }

body.dark-mode input:not(.login-input),
body.dark-mode select:not(#newuser-role),
body.dark-mode textarea {
  background: #252838 !important;
  color: #e0e2ec !important;
  border-color: #2e3147 !important;
}
body.dark-mode .gantt-bar-bg   { background: #252838; }
body.dark-mode .gantt-header-row td { background: #252838; color: #9a9db8; }
body.dark-mode .gantt-label    { color: #c0c4d8; background: #1e2130; }

/* Modals dark: only the overlay backgrounds, keep content readable */
body.dark-mode #add-task-modal > div,
body.dark-mode #subtask-modal > div,
body.dark-mode #arb-modal > div,
body.dark-mode #audit-modal > div {
  background: #1e2130 !important;
  color: #e8eaf2 !important;
}
body.dark-mode #btn-layout-toggle {
  background: #252838; border-color: #3a4060; color: #a0b0d0;
}
body.dark-mode #btn-dark-toggle {
  background: #2a2c40; border-color: #3a3d58; color: #e0e0f0;
}
#relance-modal.hidden     { display: none !important; }
