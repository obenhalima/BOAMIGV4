    // Fallback CSV
    const csv = 'Feuille;Actions\nid;action;resp;domaine;urgence;rag;deadline;commentaire\nACT_001;Ma premiÃ¨re action;Jean Dupont;Finance;Critique;R;2026-06-30;Commentaire exemple\n';
