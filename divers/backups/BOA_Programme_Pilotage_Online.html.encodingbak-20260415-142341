/**
 * Synchronise l'avancement d'une action vers la tÃ¢che Gantt liÃ©e (_ganttTaskId).
 * Doit Ãªtre appelÃ©e aprÃ¨s chaque modification de status ou pct d'une action.
 */
function _syncActionToGanttTask(actId) {
  const act = [...actions, ...(state.customActions || [])].find(a => a.id === actId);
  if (!act || !act._ganttTaskId) return;
  const ganttId = act._ganttTaskId;
  const saved   = state.actions[actId] || {};
  const status  = saved.status || 'todo';

  // Calcul du % Gantt (0-1) Ã  partir du statut et du % action (0-100)
  let pct;
  if (status === 'done')                          pct = 1;
  else if (status === 'todo' || status === 'cancelled') pct = 0;
  else                                            pct = Math.min(1, (saved.pct || 0) / 100);

  // Mettre Ã  jour la tÃ¢che custom si elle existe
  const ct = (state.ganttCustom || []).find(t => t.id === ganttId);
  if (ct) ct.pct = pct;

  // Mettre Ã  jour les overrides (tÃ¢ches statiques ET custom)
  if (!state.gantt[ganttId]) state.gantt[ganttId] = {};
  state.gantt[ganttId]._pct = pct;

  if (typeof renderGantt === 'function') renderGantt();
}

/**
 * CrÃ©e une action liÃ©e dans le plan d'action pour une tÃ¢che Gantt existante.
 * Ne fait rien si une action liÃ©e existe dÃ©jÃ .
 * Retourne true si l'action a Ã©tÃ© crÃ©Ã©e, false si elle existait dÃ©jÃ .
 */
function _addTaskToActionPlan(taskId) {
  if (!canEdit()) return false;
  // VÃ©rifier qu'une action liÃ©e n'existe pas dÃ©jÃ 
  const existing = (state.customActions || []).find(a => a._ganttTaskId === taskId);
  if (existing) {
    showToast('â„¹ï¸ Une action est dÃ©jÃ  liÃ©e Ã  cette tÃ¢che (' + existing.id + ')', 2000);
    return false;
  }
  // Trouver la tÃ¢che Gantt
  const allT = [...ganttTasks, ...(state.ganttCustom || [])];
  const task  = allT.find(t => t.id === taskId);
  if (!task || task.type === 'phase' || task.type === 'jalon') return false;

  const {start, end} = getTaskDates(task);
  const ov       = (!task._custom && state.gantt[taskId]) ? state.gantt[taskId] : {};
  const label    = ov._label  || task.label || '';
  const resp     = ov._owner  || task.owner || task.resp || 'â€”';
  const pct0     = ov._pct    != null ? ov._pct : (task.pct || 0);
  const pctInt   = Math.round(pct0 * 100);
  const domains  = task._custom ? (task.domains || []) : (ov._domains || []);
  const dur      = Math.max(0, Math.round((new Date(end) - new Date(start)) / 86400000));
  const initStatus = pct0 >= 1 ? 'done' : pct0 > 0 ? 'in_progress' : 'todo';

  const actId  = 'ACT_' + taskId.replace('custom_', '').replace(/[^a-zA-Z0-9_]/g, '_');
  if (!state.customActions) state.customActions = [];
  const newAct = {
    id: actId, category: 'metier',
    domain:   (domains && domains.length > 0) ? domains[0] : '',
    action:   label, resp, side: 'BOA',
    dependsOn: [], _custom: true, _history: [],
    _ganttTaskId: taskId
  };
  _pushHistory(newAct, 'created');
  state.customActions.push(newAct);
  if (!state.actions[actId]) state.actions[actId] = {};
  Object.assign(state.actions[actId], { status: initStatus, pct: pctInt, dateDebut: start, duree: dur });

  saveState('Action crÃ©Ã©e depuis Gantt', label.substring(0, 80));
  if (typeof renderActions   === 'function') renderActions();
  if (typeof renderDashboard === 'function') renderDashboard();
  if (typeof renderGantt     === 'function') renderGantt();
  showToast('âœ… Action ' + actId + ' ajoutÃ©e au plan d\'action', 2500);
  return true;
}

/**
 * CrÃ©e des actions pour les tÃ¢ches Gantt VISIBLES qui n'en ont pas encore.
 * N'inclut que les tÃ¢ches rÃ©ellement affichÃ©es dans le Gantt (mode CBS ou custom).
 * AppelÃ© par le bouton "ðŸ“‹ â†’ Actions" dans la barre du Gantt.
 */
function _syncAllTasksToActions() {
  if (!canEdit()) return;

  // Reconstruire exactement la liste des tÃ¢ches affichÃ©es dans le Gantt (mÃªme logique que renderGantt)
  const _hiddenSet = new Set(state.ganttHidden || []);
  const customAfter  = {};
  const customOrphan = [];
  (state.ganttCustom || []).forEach(ct => {
    const anchor = ct.insertAfterId || null;
    if (anchor) { if (!customAfter[anchor]) customAfter[anchor] = []; customAfter[anchor].push(ct); }
    else { customOrphan.push(ct); }
  });

  const visibleTasks = [];
  const _seen = new Set();
  function _collect(task) {
    if (_seen.has(task.id) || _hiddenSet.has(task.id)) return;
    _seen.add(task.id);
    visibleTasks.push(task);
    (customAfter[task.id] || []).forEach(_collect);
  }

  if (_projUsesCBS()) {
    ganttTasks.forEach(t => { if (!_hiddenSet.has(t.id)) _collect(t); });
  }
  customOrphan.forEach(t => { if (!_seen.has(t.id)) _collect(t); });

  // Filtrer : uniquement les tÃ¢ches de type "task" (pas phases, jalons, sous-tÃ¢ches)
  const tasks = visibleTasks.filter(t => t.type === 'task');

  const linkedIds = new Set((state.customActions || []).filter(a => a._ganttTaskId).map(a => a._ganttTaskId));
  const unlinked  = tasks.filter(t => !linkedIds.has(t.id));

  if (unlinked.length === 0) {
    showToast('âœ… Toutes les tÃ¢ches visibles sont dÃ©jÃ  dans le plan d\'action.', 2500);
    return;
  }

  // Confirmation si beaucoup de tÃ¢ches
  if (unlinked.length > 5) {
    if (!confirm(unlinked.length + ' tÃ¢ches vont Ãªtre ajoutÃ©es au plan d\'action.\nContinuer ?')) return;
  }

  let created = 0;
  unlinked.forEach(t => { if (_addTaskToActionPlan(t.id)) created++; });
  showToast('âœ… ' + created + ' tÃ¢che(s) ajoutÃ©e(s) au plan d\'action.', 3000);
}

