function getTaskDates(task) {
  const s = state.gantt[task.id];
  return { start: (s && s.start) || task.start, end: (s && s.end) || task.end };
}

function taskDuration(task) {
  const {start, end} = getTaskDates(task);
  const s = new Date(start), e = new Date(end);
  return Math.max(1, Math.round((e - s) / 86400000));
}

function addDays(dateStr, days) {
  const d = new Date(dateStr);
  d.setDate(d.getDate() + days);
  return d.toISOString().split('T')[0];
}

function toggleChain(on) {
  state.ganttChain = on;
  saveState();
}

// Peuple dynamiquement le select "Phase de rattachement" avec les phases existantes du Gantt.
// option.value        = clÃ© CSS couleur (ex: "p0", "p1" â€¦ ou "p0" dÃ©rivÃ© si phase custom)
// option.dataset.phaseId = id rÃ©el de la phase (pour ancrer la tÃ¢che via insertAfterId)
// selectedValue peut Ãªtre : une clÃ© CSS ("p0"â€¦) ou un id de phase ("1", "custom_xxx")
function _populateGanttPhaseSelect(selectedValue) {
  const sel = document.getElementById('new-task-phase');
  if (!sel) return;

  const hiddenSet = new Set(state.ganttHidden || []);
  const phases = [...ganttTasks, ...(state.ganttCustom || [])]
    .filter(t => t.type === 'phase' && !hiddenSet.has(t.id));

  sel.innerHTML = '';

  if (phases.length === 0) {
    const opt = document.createElement('option');
    opt.value = ''; opt.dataset.phaseId = '';
    opt.textContent = 'â€” Aucune phase disponible â€”';
    sel.appendChild(opt);
    return;
  }

  const blank = document.createElement('option');
  blank.value = ''; blank.dataset.phaseId = '';
  blank.textContent = 'â€” Choisir une phase â€”';
  sel.appendChild(blank);

  phases.forEach((p, idx) => {
    const opt = document.createElement('option');
    // ClÃ© CSS : si la phase a un code p0..p5 valide, on le garde; sinon on dÃ©rive de l'index
    const colorKey = (p.phase && /^p\d+$/.test(p.phase)) ? p.phase : ('p' + (idx % 6));
    opt.value          = colorKey;   // utilisÃ© pour la couleur de la barre
    opt.dataset.phaseId = p.id;      // utilisÃ© pour le positionnement (insertAfterId)
    opt.textContent    = p.label || p.id;
    sel.appendChild(opt);
  });

  // SÃ©lection : accepte colorKey OU phaseId comme selectedValue
  if (selectedValue) {
    // Essai 1 : correspondance directe par value (colorKey)
    let found = Array.from(sel.options).find(o => o.value === selectedValue);
    // Essai 2 : correspondance par phaseId (dataset)
    if (!found) found = Array.from(sel.options).find(o => o.dataset.phaseId === selectedValue);
    if (found) sel.value = found.value;
    else sel.selectedIndex = 1; // fallback sur 1Ã¨re phase rÃ©elle (index 1, aprÃ¨s le blank)
  } else {
    sel.selectedIndex = 1; // par dÃ©faut : 1Ã¨re phase du Gantt
  }
}

